# Private Langfuse project (prompts/traces stay out of this public repo)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# Runtime
MAX_CONCURRENCY=4
EVAL_CLAUDE_MODEL=claude-sonnet-5
EVAL_CLAUDE_EFFORT=medium
EVAL_CODEX_MODEL=gpt-5.6-sol
EVAL_CODEX_REASONING_EFFORT=medium

# Live nimble tool runs (optional for skill_selection-only smoke)
NIMBLE_API_KEY=

# Paths
# AGENT_SKILLS_ROOT=/path/to/agent-skills
# EVAL_RESULTS_DIR=~/.nimble/skills-evals/results
# EVAL_TRACES_DIR=~/.nimble/skills-evals/traces
